# ---- Database (Neon Postgres) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Provider API keys (used by the WORKER only) ----
 _API_KEY=
PEXELS_API_KEY=
ELEVENLABS_API_KEY=
KIE_API_KEY=

# ---- Worker / storage ----
# Where the worker stores downloaded media, audio and final MP4s
STORAGE_DIR=./storage
# Public URL where the worker's storage is reachable (served by the worker on WORKER_PORT)
# Local dev: http://localhost:4000   VPS: https://media.yourdomain.com
STORAGE_PUBLIC_URL=http://localhost:4000
WORKER_PORT=4000
# How many projects one worker processes at the same time
WORKER_CONCURRENCY=1

# ---- Web (Next.js) ----
NEXT_PUBLIC_APP_NAME=VidForge

# ---- Provider tuning (optional, defaults are fine) ----
DEEPSEEK_MODEL=deepseek-chat
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Leave empty to auto-pick a voice by style; or paste a voice ID from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
KIE_MODEL=V4_5
# Kie requires a callback URL even when we poll. Any https URL is accepted.
KIE_CALLBACK_URL=https://example.com/kie-callback

# ---- Rendering ----
# Parallel ffmpeg encoders for shot clips (2 for a laptop, 4+ on a VPS with several cores)
RENDER_PARALLEL=2
# Path to a FULL ffmpeg build if the one on PATH is a slim build (Mac: brew install ffmpeg-full)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Alternative voice provider (ElevenLabs-compatible API, e.g. a reseller) ----
# Leave empty to use ElevenLabs directly with ELEVENLABS_API_KEY.
VOICE_API_BASE_URL=
VOICE_API_KEY=
# xi-api-key (ElevenLabs style) or bearer (Authorization: Bearer <key>)
VOICE_AUTH_STYLE=xi-api-key

# ---- AbhiBots (https://app.abhibots.com) — alternative voice + image provider ----
VOICE_PROVIDER=elevenlabs        # elevenlabs | abhibots
IMAGE_PROVIDER=kie               # kie | abhibots
ABHIBOTS_API_KEY=                # starts with abhi_live_
ABHIBOTS_IMAGE_MODEL=nano_banana_2

# ---- Speed ----
IMAGE_CONCURRENCY=6     # parallel AI image tasks (raise to 8-10 if Kie allows; lower on rate-limit errors)
STOCK_CONCURRENCY=3     # parallel Pexels lookups

# ---- SnapGen (api.snapgen.ai) — alternative AI image provider ----
# IMAGE_PROVIDER=snapgen
SNAPGEN_API_KEY=
SNAPGEN_IMAGE_MODEL=nano-banana-2      # nano-banana-pro (free, 5/min) | nano-banana-2 | nano-banana-2-lite
SNAPGEN_RESOLUTION=1K
# Poll URL for in-progress generations (see docs.snapgen.ai/resources/history-apis); {uuid} is replaced
SNAPGEN_HISTORY_URL=https://api.snapgen.ai/uapi/v1/history/{uuid}
# Requests per minute for SnapGen (auto: 5 for nano-banana-pro, unlimited otherwise)
SNAPGEN_RPM=
# On startup, release locks left by a previous worker process (set to false if you run several workers)
WORKER_RELEASE_LOCKS_ON_START=true

# ---- AI video (SnapGen Veo/Omni) ----
SNAPGEN_VIDEO_MODEL=veo-3.1-fast          # veo-3.1 | veo-3.1-fast | veo-3.1-lite | veo-2 | omni-flash
SNAPGEN_VIDEO_MODEL_PORTRAIT=veo-2        # used for 9:16 (veo-3.1 family is 16:9 only)
SNAPGEN_VIDEO_RESOLUTION=720p             # 720p | 1080p (final video is scaled to the project size)
VIDEO_CONCURRENCY=3                       # parallel video clips
# Font file for thumbnail text (needed for Hindi/Devanagari): e.g. /System/Library/Fonts/Supplemental/Kohinoor.ttc
THUMBNAIL_FONT=
# AI video: true = image first then animate (consistent look), false = pure text-to-video, no images at all
VIDEO_FROM_IMAGE=true

# ---- Fonts (fix "boxes" in captions/overlays/thumbnails) ----
# Files used by drawtext (thumbnails, overlays, title cards). Defaults try Arial Black / Kohinoor on Mac, DejaVu / Noto on Ubuntu.
THUMBNAIL_FONT=
FONT_DEVANAGARI=
# Family names used by libass captions
CAPTION_FONT=
CAPTION_FONT_DEVANAGARI=
# Music fallback model when the primary Kie model errors (V4 is the most stable)
KIE_MUSIC_FALLBACK_MODEL=V4
VOICE_CONCURRENCY=6     # parallel voice segments

# ---- Accounts & billing (web) ----
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=https://app.y2ube.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Admin ----
WORKER_ADMIN_TOKEN=change-me-shared-between-web-and-worker

# ---- Email (worker; optional) ----
RESEND_API_KEY=
EMAIL_FROM=Y2ube <no-reply@y2ube.io>
APP_URL=https://app.y2ube.io

# ---- Operations (worker) ----
RENDER_KEEP_DAYS=3        # days to keep per-project render intermediates
DISK_ALERT_FREE_GB=15     # email ADMIN_EMAIL below this
ADMIN_EMAIL=

# ---- Community voice library (worker) ----
ELEVENLABS_API_KEY=            # direct ElevenLabs key: browses the shared library; adding voices needs a paid tier on that account

# ---- Stripe (web / Vercel) ----
STRIPE_SECRET_KEY=            # sk_live_… (or sk_test_… while testing)
STRIPE_WEBHOOK_SECRET=        # whsec_… from Developers → Webhooks → your endpoint

# ---- Speed / capacity (worker) ----
IMAGE_PROVIDER=kie                 # fastest; falls back through IMAGE_FALLBACK_PROVIDERS
IMAGE_FALLBACK_PROVIDERS=snapgen,abhibots
MUSIC_LIBRARY=on                   # pick pre-generated tracks (npm run music:library) instead of generating per video
RENDER_SLOTS=3                     # simultaneous project renders per machine (CPU-bound)
USER_MAX_INFLIGHT=3                # max running projects per user (fairness)
WORKER_CONCURRENCY=10
PRESENTER_MAX_CLIPS=0          # 0 = one face-cam clip per spoken part of the script (the face never freezes).
                               # Set a number to cap it on long videos: each clip is ~25 credits and several minutes of Veo.
                               # Presenter clips are always MUTED — the TTS narration is the only voice.
VIDEO_PROVIDER=snapgen         # snapgen | kie (Veo 3 via Kie.ai); the other is used as fallback
KIE_VIDEO_MODEL=veo3_fast
KIE_VIDEO_TIMEOUT_MS=720000
