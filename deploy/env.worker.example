# /var/www/vidforge/.env on the VPS (the worker reads the repo-root .env). Copy your Mac .env, then change:
STORAGE_DIR=/opt/vidforge-storage
STORAGE_PUBLIC_URL=https://media.yourdomain.com     # the worker domain from setup-worker-vps.sh
WORKER_PORT=4000
RENDER_PARALLEL=4                                    # = CPU cores of the VPS
VIDEO_CONCURRENCY=8
IMAGE_CONCURRENCY=8
VOICE_CONCURRENCY=6
# leave THUMBNAIL_FONT empty on Ubuntu (Noto fonts are found automatically)
