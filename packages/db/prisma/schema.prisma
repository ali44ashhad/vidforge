generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  QUEUED
  SCRIPTING
  STORYBOARDING
  FETCHING_MEDIA
  VOICE_GENERATION
  MUSIC_GENERATION
  ASSEMBLING
  RENDERING
  FINALIZING
  COMPLETED
  FAILED
  PAUSED
}

enum BatchStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum AspectRatio {
  R16_9
  R9_16
  R1_1
  R4_5
}

enum MediaType {
  VIDEO
  IMAGE
}

enum RenderStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Bulk generation
// ---------------------------------------------------------------------------

model Batch {
  id        String      @id @default(cuid())
  userId    String      @default("local")
  name      String
  status    BatchStatus @default(QUEUED)
  total     Int         @default(0)
  completed Int         @default(0)
  failed    Int         @default(0)
  /// Shared settings applied to every project in the batch (voice, captions, format...)
  settings  Json?
  projects  Project[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Project = one final video
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}
enum LedgerType {
  GRANT
  PURCHASE
  RESERVE
  SETTLE
  RELEASE
  REFUND
  ADJUST
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  passwordHash  String?
  googleId      String?  @unique
  role          UserRole @default(USER)
  plan          String   @default("free")
  planExpiresAt DateTime?
  /// cached: sum of ledger entries (GRANT+PURCHASE+REFUND+RELEASE − RESERVE − SETTLE ± ADJUST)
  credits       Int      @default(0)
  suspended     Boolean  @default(false)
  /// Connected YouTube channel: { channelId, channelTitle, thumbnail, refreshTokenEnc, connectedAt }
  youtube       Json?
  /// Brand kit defaults applied to new videos: { logoUrl, logoPath, logoPosition, brandColor, accentColor, voiceId, voiceStyle, imageStyle, captionStyle, look }
  brandKit      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ledger        CreditLedger[]
  payments      Payment[]
}

/// Append-only. Positive amount = credits in, negative = credits out.
model CreditLedger {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LedgerType
  amount     Int
  balance    Int        // balance after this entry
  projectId  String?
  paymentId  String?
  reason     String?
  actorId    String?    // admin user id for GRANT/ADJUST/REFUND
  createdAt  DateTime   @default(now())
  @@index([userId, createdAt])
  @@index([projectId])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  amount          Int      // paise
  currency        String   @default("INR")
  credits         Int
  provider        String   @default("razorpay")
  orderId         String   @unique
  paymentRef      String?  @unique
  status          String   @default("created") // created | paid | failed
  createdAt       DateTime @default(now())
  paidAt          DateTime?
}

/// Admin-editable overrides on top of code defaults. Keys: "template:<id>", "plan:<id>", "voice-default:<language>", "credit-rates"
/// Saved video ideas and planned content (content calendar)
model Idea {
  id           String    @id @default(cuid())
  userId       String
  title        String
  topic        String?
  format       String?   // video type id
  length       Int?      // seconds
  potential    String?   // high | medium | low
  competition  String?   // low | medium | high
  why          String?
  status       String    @default("idea") // idea | planned | draft | generating | ready | scheduled | published | dismissed
  plannedFor   DateTime?
  projectId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([userId, status])
  @@index([userId, plannedFor])
}

/// Creator Academy lessons (global; generated by an admin with the pipeline)
model Lesson {
  id          String   @id @default(cuid())
  courseId    String   @default("main")
  order       Int      @default(0)
  category    String
  title       String
  description String?
  prompt      String?
  projectId   String?  // the generated video
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([courseId, order])
}

/// ElevenLabs shared Voice Library (~16k voices), synced nightly by the worker
model CommunityVoice {
  voiceId       String   @id
  publicOwnerId String
  name          String
  gender        String?
  age           String?
  accent        String?
  language      String?
  useCase       String?
  category      String?
  description   String?
  previewUrl    String?
  clonedBy      Int      @default(0)
  addedAt       DateTime? // when it was added to our account (usable for TTS)
  updatedAt     DateTime @updatedAt
  @@index([language, gender])
  @@index([clonedBy])
}

/// Pre-generated background music, picked per video instead of generating a new track (seconds instead of minutes)
model MusicLibraryTrack {
  id        String   @id @default(cuid())
  style     String   // one of MUSIC_STYLES
  mood      String?
  prompt    String
  localPath String
  audioUrl  String
  duration  Float
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  @@index([style])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    // first 8 chars, shown in the UI
  hash       String    @unique // sha256 of the full key
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  @@index([userId])
}

model ConfigOverride {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Project {
  id             String        @id @default(cuid())
  userId         String        @default("local")
  /// credits reserved at creation and settled at finalize
  creditsReserved Int          @default(0)
  creditsCharged  Int          @default(0)
  batchId        String?
  showcaseSlot   String?       @unique // homepage slot id (see apps/web/lib/showcase.ts)
  batch          Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)

  title          String
  prompt         String
  targetDuration Int           // seconds requested by user
  actualDuration Float?        // seconds, measured from real narration audio
  aspectRatio    AspectRatio   @default(R16_9)
  language       String        @default("English")
  videoType      String        @default("YouTube Video")
  style          String?
  voiceId        String?
  voiceStyle     String        @default("Professional")
  voiceSpeed     Float         @default(1.0)
  captionsEnabled Boolean      @default(true)
  captionStyle   String        @default("YouTube Clean")
  cta            String?

  /// "stock_videos" | "ai_images" | "mixed"
  visualSource   String        @default("mixed")
  /// Style suffix for AI-generated images (e.g. "cinematic photo, natural light")
  imageStyle     String?
  musicEnabled   Boolean       @default(true)
  /// Preset name from MUSIC_STYLES or "Custom"
  musicStyle     String        @default("Auto")
  /// User-written music prompt (used when musicStyle = "Custom")
  musicCustomPrompt String?
  /// { voiceVolume, musicVolume, duck, fadeIn, fadeOut }
  mixSettings    Json?
  logoUrl        String?
  logoPath       String?
  /// top_right | top_left | bottom_right | bottom_left
  logoPosition   String        @default("top_right")
  /// AI presenter ("face cam"): a photo of the presenter; Veo generates lip-synced clips composited as a circle over the video
  presenterMode     String     @default("off")          // off | ai
  presenterImageUrl String?
  presenterImagePath String?
  presenterPosition String     @default("bottom_left")  // bottom_left | bottom_right | top_left | top_right
  presenterSize     Int        @default(34)             // % of video width
  presenterRing     String     @default("#6C4CFF")
  presenterShape    String     @default("circle")       // circle | cutout (green-screen keyed, no frame)
  /// Story mode: characters with reference images and (optionally) their own voices
  /// true = the prompt IS the script: spoken word for word, only split into scenes
  scriptVerbatim   Boolean     @default(false)
  /// Output: "720p" | "1080p" | "4k" (applied to the aspect ratio)
  outputQuality    String      @default("1080p")
  /// AI video clip resolution requested from the provider: "720p" | "1080p"
  aiVideoResolution String     @default("720p")
  voiceEnabled     Boolean     @default(true)
  /// Ad banners burned into the video: { top, topHighlight, bottom, color }
  banners          Json?
  /// User reference images: [{ url, path, kind: subject|style|location|character, label }]
  referenceImages  Json?
  /// Finishing look id (see shared/looks.ts) and 0-100 intensity
  look             String      @default("auto")
  lookIntensity    Int         @default(70)
  /// AI-chosen grade when look = "auto": { contrast, saturation, brightness, warmth, sharpen, vignette, grain, leak }
  lookParams       Json?
  textOverlaysEnabled Boolean  @default(true)
  /// AI-images mode: if an image fails, use a stock photo (true) or a title card (false)
  allowStockFallback Boolean   @default(false)
  storyMode        Boolean     @default(false)
  characterVoices  Boolean     @default(true)
  /// false = no narrator lines at all; every line is spoken by a character
  narratorEnabled  Boolean     @default(true)
  /// "tts" (our voices) or "veo_native" (Veo speaks the lines with lip-sync; AI-video modes only)
  speechMode       String      @default("tts")
  characterCount   Int         @default(2)
  characters       ProjectCharacter[]

  status         ProjectStatus @default(QUEUED)
  currentStage   String?
  progress       Int           @default(0)   // 0-100 overall
  error          String?
  attempts       Int           @default(0)
  pauseRequested Boolean       @default(false)
  lockedAt       DateTime?     // set while a worker owns this project
  /// { completedStages: string[], ...anything the pipeline needs to resume }
  checkpoint     Json?

  /// DeepSeek video strategy (title, hook, outline, target words...)
  strategy       Json?
  /// Full narration script (plain text, written for audio)
  script         String?
  /// Prompt sent to the music provider
  musicPrompt    String?
  /// Live counters shown on the generation screen (words, shots, assets found...)
  stats          Json?
  /// Publish kit: titles, description, tags, hashtags, thumbnails (see services/seo.ts)
  seo            Json?

  finalVideoUrl  String?
  thumbnailUrl   String?
  captionsUrl    String?
  fileSize       Float?
  width          Int?
  height         Int?

  chapters       Chapter[]
  voiceSegments  VoiceSegment[]
  musicTracks    MusicTrack[]
  renderJobs     RenderJob[]
  assetUsages    ProjectAsset[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, lockedAt])
  @@index([batchId])
}

model Chapter {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  narration String
  musicMood String?
  startTime Float?
  endTime   Float?
  scenes    Scene[]

  @@unique([projectId, order])
}

model Scene {
  id           String        @id @default(cuid())
  chapterId    String
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order        Int
  narration    String
  /// Story mode: [{ speaker: "narrator" | characterName, text }]
  lines        Json?
  startTime    Float?
  endTime      Float?
  shots        Shot[]
  voiceSegment VoiceSegment?

  @@unique([chapterId, order])
}

model Shot {
  id                String      @id @default(cuid())
  sceneId           String
  scene             Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  order             Int
  startTime         Float?
  endTime           Float?
  duration          Float       // planned seconds (recalculated after voice timing)
  visualDescription String
  videoQueries      String[]
  imageQueries      String[]
  onScreenText      String?
  transition        String      @default("cut")
  motion            String      @default("zoom_in")
  /// Story mode: names of characters visible in this shot
  characterNames    String[]    @default([])
  /// Scene editor: user-chosen source for this shot { type: "pexels_video"|"pexels_photo"|"upload", id?, url?, path?, kind? }
  pinnedSource      Json?
  /// Native-speech mode: the line spoken in this clip, "speaker: text"
  dialogue          String?
  /// Native-speech mode: extracted or TTS audio for this shot
  audioPath         String?
  mediaAssetId      String?
  mediaAsset        MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  /// Trim start inside the source clip (seconds)
  clipOffset        Float       @default(0)

  presenterUrl   String?   // AI presenter clip for this shot (face-cam overlay)
  presenterPath  String?

  @@unique([sceneId, order])

}

// ---------------------------------------------------------------------------
// External assets + provenance
// ---------------------------------------------------------------------------

model MediaAsset {
  id              String         @id @default(cuid())
  provider        String         // "pexels"
  providerAssetId String
  type            MediaType
  url             String         // best-quality download URL from provider
  localPath       String?        // path on the worker's disk once cached
  previewUrl      String?
  creator         String?
  creatorUrl      String?
  sourceUrl       String?        // provider page for attribution
  license         String?        // e.g. "Pexels License"
  width           Int
  height          Int
  duration        Float?         // videos only
  /// Provider-specific extras (e.g. AI image prompt + generation id)
  meta            Json?
  downloadedAt    DateTime?
  shots           Shot[]
  usages          ProjectAsset[]
  createdAt       DateTime       @default(now())

  @@unique([provider, providerAssetId])
}

/// Record of every asset used in a project (also drives "don't repeat footage").
model ProjectAsset {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  usedAt       DateTime   @default(now())

  @@id([projectId, mediaAssetId])
}

model VoiceSegment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId      String   @unique
  scene        Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  order        Int
  provider     String   // "elevenlabs"
  voiceId      String
  text         String
  audioUrl     String
  localPath    String?
  duration     Float    // REAL seconds measured with ffprobe
  generationId String?
  /// Word-level timestamps from the provider, used for caption sync
  alignment    Json?
  createdAt    DateTime @default(now())
}

model MusicTrack {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId    String?
  order        Int      @default(0)
  provider     String   // "kie"
  prompt       String
  audioUrl     String?
  localPath    String?
  duration     Float?
  generationId String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}

model RenderJob {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       RenderStatus @default(QUEUED)
  progress     Int          @default(0)
  currentStage String?
  outputUrl    String?
  error        String?
  createdAt    DateTime     @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
}

/// Cached provider search results (Pexels has an hourly request limit).
model SearchCache {
  key       String   @id
  payload   Json
  createdAt DateTime @default(now())
}

/// ElevenLabs voices synced by the worker so the web app can show a picker with previews.
model Voice {
  id         String   @id            // ElevenLabs voice_id
  name       String
  category   String?
  labels     Json?
  previewUrl String?
  updatedAt  DateTime @updatedAt
}

/// A reusable story character (library item). Reference image keeps the look consistent across shots.
model Character {
  id                 String   @id @default(cuid())
  userId             String   @default("local")
  name               String
  description        String   // appearance: age, hair, outfit, species...
  personality        String?
  gender             String?  // male | female
  ageGroup           String?  // child | teen | young adult | adult | senior
  ethnicity          String?  // e.g. "Punjabi Indian, fair skin"
  voiceHint          String?  // e.g. "young girl, cheerful"
  voiceId            String?
  referenceImageUrl  String?  // provider URL usable as image_input
  referenceImagePath String?
  referencePublicUrl String?  // served by the worker, for the UI
  createdAt          DateTime @default(now())
  projects           ProjectCharacter[]
}

model ProjectCharacter {
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  order       Int       @default(0)

  @@id([projectId, characterId])
}
